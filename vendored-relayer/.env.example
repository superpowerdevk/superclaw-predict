
PRIVATE_KEY=0x...

POLY_RELAYER_ADDRESS=0x...

SIGNATURE_TYPE=3

# ── Auth (pick one) ─────────────────────────────────────────────────

# Option A: Builder API Key (HMAC) — recommended; works with V2 too.
BUILDER_KEY=your_builder_api_key
BUILDER_SECRET=your_base64_encoded_secret
BUILDER_PASSPHRASE=your_passphrase

# Option B: Relayer API Key (from polymarket.com/settings > API Keys)
# POLY_RELAYER_API_KEY=your_relayer_api_key

# ── Polygon RPC ─────────────────────────────────────────────────────
# WARNING: Do NOT use https://polygon-rpc.com — it has TLS issues.
# Use Alchemy, QuickNode, or LlamaRPC instead.
#
# Required for:
#   * Direct on-chain fallback (DirectExecutor)
#   * Reading the on-chain Safe nonce to avoid stale-API GS026 errors
# Optional for Deposit Wallet flow (all state queried via the relayer).
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# ── V2 examples (split_merge_pusd, split_merge_pusd_deposit_wallet) ─

# 32-byte hex condition id for the market you want to split/merge.
# Get it from the Polymarket gamma-api or the CTF UI URL.
CONDITION_ID=0x...

# Amount in raw 6-decimal pUSD units (1 pUSD = 1_000_000).
AMOUNT=2000000

# Market kind: "regular" (binary YES/NO) or "neg_risk" (multi-outcome).
MARKET_TYPE=regular

# Which steps to run: "both" (split then merge), "split" only, or "merge" only.
STEP=both

# Set to 1 to prepend pUSD/CTF approvals to the batch (run once per wallet).
APPROVE=0

# Set to 1 to deploy the Deposit Wallet via the relayer before executing the
# batch. Run once per EOA, only for the *_deposit_wallet example.
DEPLOY=0

# How many seconds from now the EIP-712 Batch signature stays valid.
# Used by split_merge_pusd_deposit_wallet. The TS reference uses 240 (4 min).
DEADLINE_SECS=240
